# Terraform working directories and local state
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Plan files can hold secret values from state
*.tfplan
tfplan

# Variable files can hold credentials; defaults live in variables-*.tf
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Local environment files
.env
.env.*

# Editors and operating systems
.DS_Store
.idea/
.vscode/
